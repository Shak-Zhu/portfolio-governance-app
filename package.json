{
  "name": "pmo-governance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shak 项目组合治理系统 - Cloudflare Worker + D1（单用户网页登录 + Bearer MCP）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "lint": "eslint src/**/*.ts",
    "test": "node scripts/unit-test.mjs",
    "test:e2e": "node scripts/real-mcp-test.mjs",
    "test:scheduled": "node scripts/test-scheduled.mjs",
    "db:migrate": "wrangler d1 migrations apply pmo-governance-prod --local",
    "db:init": "wrangler d1 execute pmo-governance-prod --local --file=./drizzle/seed.sql",
    "db:smoke": "node scripts/smoke-test.js",
    "db:create": "wrangler d1 create pmo-governance-local",
    "agent:manifest": "node scripts/generate-agent-manifest.mjs",
    "skill:build": "node scripts/generate-agent-manifest.mjs",
    "mcp:test": "node scripts/mcp-test.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "hono": "^4.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.60.0"
  }
}
