{
  "name": "pmo-governance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "多项目治理 Web App - Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "lint": "eslint src/**/*.ts",
    "test": "node --experimental-vm-modules scripts/unit-test.cjs",
    "db:migrate": "wrangler d1 migrations apply pmo-governance-prod --local",
    "db:init": "wrangler d1 execute pmo-governance-prod --local --file=./drizzle/seed.sql",
    "db:smoke": "node scripts/smoke-test.js",
    "db:create": "wrangler d1 create pmo-governance-local"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0",
    "wrangler": "^3.60.0"
  }
}
